# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY=your_api_key_optional_for_signed_uploads

# Client-safe public Cloud Name & optional unsigned upload preset (Vite)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# MongoDB Connection String (Server-side only)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/blvrsdb?retryWrites=true&w=majority

# Cron Job Authentication Secret (Server-side only)
CRON_SECRET=your_cron_secret

# Admin Panel Credentials (Server-side only)
ADMIN_EMAIL=admin@blvrsmedia.com
ADMIN_PASSWORD=your_secure_admin_password
